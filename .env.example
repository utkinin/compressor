# Copy to .env.local. Never commit .env.local or real credentials.
# Staging always stores synthetic RFQ locally; it never sends to CRM.
RFQ_STAGING_MODE=true
RFQ_STORE_DIR=.local/rfq
RFQ_RETENTION_DAYS=30

# Replace with the actual HTTPS origin at deployment. .example is reserved.
SITE_URL=https://staging.lanfor.example
SEO_INDEXABLE=false

# Real RFQ requires all flags, approved operator text, approved hosting/processing
# arrangements, and HTTPS CRM delivery. Staging flag takes precedence.
RFQ_ENABLED=false
RFQ_LEGAL_APPROVED=false
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_CONTACT=
CONTACT_EMAIL=
CONTACT_PHONE=
RFQ_CRM_ENDPOINT=
RFQ_CRM_SECRET=
RFQ_FALLBACK_ENDPOINT=
RFQ_FALLBACK_SECRET=
RFQ_ALLOW_LOCAL_FALLBACK=false
# Set only behind a proxy that overwrites X-Forwarded-For.
RFQ_TRUST_PROXY=false

# Empty = no external analytics scripts or events. Requires visitor opt-in.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA4_ID=

NEXT_TELEMETRY_DISABLED=1
