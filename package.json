{
  "name": "lanfor-gas-systems",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run catalog:check",
    "build": "next build --webpack",
    "postbuild": "npm run catalog:audit && python3 scripts/audit-public-copy.py .next/server/app",
    "catalog:check": "tsx scripts/check-public-catalog.ts",
    "catalog:audit": "tsx scripts/check-public-catalog.ts --output .next",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --maxWorkers=2",
    "test:e2e": "playwright test",
    "rfq:outbox": "node --env-file-if-exists=.env.local --import tsx src/lib/rfq/outbox-cli.ts",
    "content:matrix": "tsx scripts/export-semantic-matrix.ts",
    "preview:build": "tsx scripts/build-preview.ts",
    "preview:test": "playwright test --config playwright.preview.config.ts",
    "preview:serve": "node scripts/serve-preview.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
